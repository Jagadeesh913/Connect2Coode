{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.connect2code.in/api/:path*"
    },
    {
      "source": "/refresh",
      "destination": "https://api.connect2code.in/api/v1/auth/refresh"
    },
    {
      "source": "/auth/refresh",
      "destination": "https://api.connect2code.in/api/v1/auth/refresh"
    },
    {
      "source": "/oauth2/:path*",
      "destination": "https://api.connect2code.in/oauth2/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
