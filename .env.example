# API Base URL options:
# - Production cloud backend (default): https://api.connect2code.in/api/v1
# - Vite dev/preview proxy: /api/v1 (proxies /api to VITE_PROXY_TARGET)
# - Local Spring Boot backend: http://localhost:8080/api/v1
VITE_API_BASE_URL=https://api.connect2code.in/api/v1
VITE_APP_NAME=Connect 2 Code
# Optional. Enables Brandfetch's domain-based logo CDN after local assets.
# Obtain a public client ID from https://brandfetch.com/developers/products
VITE_BRANDFETCH_CLIENT_ID=
# Optional. Backend target for Vite dev/preview proxy (/api and /oauth2).
# Defaults to https://api.connect2code.in if omitted.
VITE_PROXY_TARGET=https://api.connect2code.in
