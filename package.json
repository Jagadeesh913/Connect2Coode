{
  "name": "c2c",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-seo-assets.mjs",
    "lint": "oxlint",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test scripts/tests/*.test.mjs",
    "preview": "vite preview",
    "lint:eslint": "eslint src/",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "knip": "knip",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:api": "newman run postman/connect2code-api-contracts.postman_collection.json",
    "verify:architecture": "node scripts/verify-architecture.mjs",
    "verify:docs": "node scripts/verify-documentation.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "@monaco-editor/react": "^4.7.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@tailwindcss/vite": "^4.3.3",
    "axios": "^1.19.0",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.28.0",
    "monaco-editor": "0.55.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.84.0",
    "react-hot-toast": "^2.6.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.8",
    "jsdom": "^31.0.1",
    "knip": "^6.45.1",
    "newman": "^6.2.3",
    "oxlint": "^1.75.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.2.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "handlebars": "^4.7.10",
    "lodash": "^4.17.23",
    "flatted": "^3.4.2"
  }
}
